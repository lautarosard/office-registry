// Prisma schema — Office Registry
// Default location (prisma/schema.prisma) so `prisma migrate` / `prisma db seed`
// work without --schema flags. Migrations live in prisma/migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//====================================================
// ENUMS
//====================================================

// Single source of truth for roles (backend imports `Role` from @prisma/client).
enum Role {
  USER
  ADMIN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

//====================================================
// ENTITIES
//====================================================

model User {
  id                 String   @id @default(uuid())
  dni                String   @unique
  username           String   @unique
  fullName           String
  password           String
  role               Role     @default(USER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  // Carried in every JWT; incrementing it revokes all tokens already issued.
  tokenVersion       Int      @default(0)
  createdAt          DateTime @default(now())

  // RELATIONSHIPS
  createdRecords Record[]   @relation("RecordCreatedBy")
  updatedRecords Record[]   @relation("RecordUpdatedBy")
  auditLogs      AuditLog[]
}

// One row per document movement: `ex` is intentionally NOT unique.
model Record {
  id          String    @id @default(uuid())
  date        DateTime  @db.Date
  ex          String
  ifCode      String
  subject     String
  department  String
  forwarding  String?
  createdById String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: rows are never removed.
  deletedAt   DateTime?

  // RELATIONSHIPS
  createdBy User       @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?      @relation("RecordUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@index([ex])
  @@index([ifCode])
  @@index([date, createdAt])
}

// Append-only. A database trigger (see migrations) rejects UPDATE and DELETE.
model AuditLog {
  id            String      @id @default(uuid())
  recordId      String
  action        AuditAction
  performedById String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())

  // RELATIONSHIPS
  record      Record @relation(fields: [recordId], references: [id], onDelete: Restrict)
  performedBy User   @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([recordId, createdAt])
}
