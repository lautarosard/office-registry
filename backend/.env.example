# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Reverse proxies in front of the API: 1 behind Nginx, false when exposed
# directly. Unset = 1 in production, false otherwise.
# TRUST_PROXY=false

# --- Auth --------------------------------------------------------------
# REQUIRED. At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Brute-force protection: max attempts per IP within the window.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# --- Database (docker-compose.yml reads POSTGRES_*) --------------------
POSTGRES_USER=registry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=registerdb
POSTGRES_PORT=5432
# REQUIRED. Must match the POSTGRES_* values above. Use 127.0.0.1, not
# "localhost": the container only listens on IPv4, and trying ::1 first can
# add seconds to every new connection (and time out transactions).
DATABASE_URL=postgresql://registry:change-me@127.0.0.1:5432/registerdb?schema=public

# --- Seed (pnpm db:seed) -----------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador
# 7 or 8 digits. Placeholder: correct it from the Usuarios screen.
SEED_ADMIN_DNI=00000000
# REQUIRED for seeding. Initial password for the ADMIN account.
SEED_ADMIN_PASSWORD=
# If true (default), the admin must change the password on first login.
SEED_ADMIN_MUST_CHANGE_PASSWORD=true
