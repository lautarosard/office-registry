# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# --- Auth --------------------------------------------------------------
# REQUIRED. At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Database (docker-compose.yml reads POSTGRES_*) --------------------
POSTGRES_USER=registry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=registerdb
POSTGRES_PORT=5432
# REQUIRED. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://registry:change-me@localhost:5432/registerdb?schema=public

# --- Seed (pnpm db:seed) -----------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrador
# REQUIRED for seeding. Initial password for the ADMIN account.
SEED_ADMIN_PASSWORD=
# If true (default), the admin must change the password on first login.
SEED_ADMIN_MUST_CHANGE_PASSWORD=true
