# Copy to `.env` if you need to override defaults. `.env` is git-ignored.

# Base URL the browser uses for API calls. Keep "/api" (same origin) so the
# Vite dev proxy (and Nginx in production) forwards requests to the backend.
VITE_API_URL=/api

# Dev only: where the Vite proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:3000
